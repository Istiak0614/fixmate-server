PORT=5000
# Comma-separated exact origins allowed by CORS (no trailing slash)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...): local = from `stripe listen`, live = from the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_
CLIENT_URLS=http://localhost:3000
# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Must be the SAME database name the client's BetterAuth uses
DB_NAME=fixmate
JWT_SECRET=
# Seed script (npm run seed) — creates the admin and the demo accounts
SEED_ADMIN_EMAIL=admin@fixmate.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=